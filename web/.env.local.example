# Copie este arquivo para `.env.local` e preencha com os dados do seu
# projeto Firebase (Console → Configurações do projeto → Seus apps → Web).
# São as chaves "web", públicas (o segredo fica nas regras do Firestore),
# então o repositório pode ser público sem risco.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL pública do arquivo .apk do aplicativo Android. Só aparece o botão de
# download no site quando este valor está preenchido.
NEXT_PUBLIC_APK_URL=